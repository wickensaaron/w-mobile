language = C
headers = imported_xmltv_shim.h
headerFilter = imported_xmltv_shim.h
package = com.nuvio.app.features.livetv.xmlinterop
compilerOpts = -iwithsysroot /usr/include/libxml2
linkerOpts = -lxml2 -lz
excludedFunctions = wm_xml_fail wm_sax_start wm_sax_end wm_sax_text wm_sax_resolve wm_sax_external_subset wm_sax_entity_decl wm_sax_entity wm_sax_parameter_entity wm_sax_error wm_sax_warning

---
#include <stdlib.h>
#include <string.h>
#include <libxml/parser.h>
#include <libxml/entities.h>
#include <zlib.h>

/* SAX push parsing uses Apple's system libxml2. No DOM, global loader changes, or log output. */
typedef struct {
    xmlParserCtxtPtr parser;
    xmlSAXHandler sax;
    void *user;
    wm_xml_start_callback start;
    wm_xml_end_callback end;
    wm_xml_text_callback text;
    int failed;
} WMXmlReader;

static void wm_xml_fail(WMXmlReader *reader) {
    reader->failed = 1;
    if (reader->parser) xmlStopParser(reader->parser);
}
static void wm_sax_start(void *opaque, const xmlChar *name, const xmlChar **attributes) {
    WMXmlReader *reader = (WMXmlReader *)opaque;
    const char *channel = NULL, *start = NULL, *stop = NULL;
    if (attributes) {
        for (int i = 0; attributes[i] && attributes[i + 1]; i += 2) {
            if (!xmlStrcmp(attributes[i], BAD_CAST "channel")) channel = (const char *)attributes[i + 1];
            else if (!xmlStrcmp(attributes[i], BAD_CAST "start")) start = (const char *)attributes[i + 1];
            else if (!xmlStrcmp(attributes[i], BAD_CAST "stop")) stop = (const char *)attributes[i + 1];
        }
    }
    if (!reader->start(reader->user, (const char *)name, channel, start, stop)) wm_xml_fail(reader);
}
static void wm_sax_end(void *opaque, const xmlChar *name) {
    WMXmlReader *reader = (WMXmlReader *)opaque;
    if (!reader->end(reader->user, (const char *)name)) wm_xml_fail(reader);
}
static void wm_sax_text(void *opaque, const xmlChar *text, int length) {
    WMXmlReader *reader = (WMXmlReader *)opaque;
    if (length > 0 && !reader->text(reader->user, (const char *)text, length)) wm_xml_fail(reader);
}
static xmlParserInputPtr wm_sax_resolve(void *opaque, const xmlChar *publicId, const xmlChar *systemId) {
    /* Never load external files or network resources, including external DOCTYPEs. */
    (void)opaque; (void)publicId; (void)systemId;
    return NULL;
}
static void wm_sax_external_subset(void *opaque, const xmlChar *name, const xmlChar *externalId, const xmlChar *systemId) {
    (void)opaque; (void)name; (void)externalId; (void)systemId;
}
static void wm_sax_entity_decl(void *opaque, const xmlChar *name, int type, const xmlChar *publicId,
                               const xmlChar *systemId, xmlChar *content) {
    (void)name; (void)type; (void)publicId; (void)systemId; (void)content;
    wm_xml_fail((WMXmlReader *)opaque);
}
static xmlEntityPtr wm_sax_entity(void *opaque, const xmlChar *name) {
    xmlEntityPtr entity = xmlGetPredefinedEntity(name);
    if (!entity) wm_xml_fail((WMXmlReader *)opaque);
    return entity;
}
static xmlEntityPtr wm_sax_parameter_entity(void *opaque, const xmlChar *name) {
    /* No DTD parameter entity, including a file/network-backed parameter, is permitted. */
    (void)name;
    wm_xml_fail((WMXmlReader *)opaque);
    return NULL;
}
static void wm_sax_error(void *opaque, const char *message, ...) {
    /* Error strings may include provider data. Do not forward or print them. */
    (void)message;
    wm_xml_fail((WMXmlReader *)opaque);
}
static void wm_sax_warning(void *opaque, const char *message, ...) { (void)opaque; (void)message; }

static inline wm_xml_handle wm_xml_create(void *user, wm_xml_start_callback start, wm_xml_end_callback end, wm_xml_text_callback text) {
    WMXmlReader *reader = (WMXmlReader *)calloc(1, sizeof(WMXmlReader));
    if (!reader) return NULL;
    reader->user = user; reader->start = start; reader->end = end; reader->text = text;
    reader->sax.startElement = wm_sax_start;
    reader->sax.endElement = wm_sax_end;
    reader->sax.characters = wm_sax_text;
    reader->sax.cdataBlock = wm_sax_text;
    reader->sax.resolveEntity = wm_sax_resolve;
    reader->sax.externalSubset = wm_sax_external_subset;
    reader->sax.entityDecl = wm_sax_entity_decl;
    reader->sax.getEntity = wm_sax_entity;
    reader->sax.getParameterEntity = wm_sax_parameter_entity;
    reader->sax.error = wm_sax_error;
    reader->sax.fatalError = wm_sax_error;
    reader->sax.warning = wm_sax_warning;
    reader->parser = xmlCreatePushParserCtxt(&reader->sax, reader, NULL, 0, NULL);
    if (!reader->parser) { free(reader); return NULL; }
    /* No HUGE, RECOVER, NOENT, DTDLOAD, DTDATTR, validation, or dictionary of unrelated names. */
    xmlCtxtUseOptions(reader->parser, XML_PARSE_NONET | XML_PARSE_NODICT);
    /*
     * SAX1 otherwise preserves an ampersand in attribute values as the synthetic "&#38;".
     * Normalize XML references exactly once in libxml2; never decode callback strings again.
     * This permits only numeric references/the five predefined entities: getEntity rejects every
     * other entity, getParameterEntity and entityDecl abort, external resolution/subsets are off,
     * and the streaming byte guard rejects all DTD subsets before feeding the native parser.
     * XML_PARSE_NOENT is deliberately not enabled (its external-entity loading flag remains off).
     */
    reader->parser->replaceEntities = 1;
    reader->parser->loadsubset = 0;
    return reader;
}
static inline int wm_xml_feed(wm_xml_handle handle, const unsigned char *bytes, int size, int final) {
    WMXmlReader *reader = (WMXmlReader *)handle;
    if (!reader || reader->failed || size < 0) return 0;
    int result = xmlParseChunk(reader->parser, (const char *)bytes, size, final);
    return result == 0 && !reader->failed && (!final || reader->parser->wellFormed);
}
static inline void wm_xml_destroy(wm_xml_handle handle) {
    WMXmlReader *reader = (WMXmlReader *)handle;
    if (reader) { xmlFreeParserCtxt(reader->parser); free(reader); }
}

/* zlib validates each gzip member's CRC/trailer; one fixed output buffer, never a full decoded feed. */
typedef struct {
    z_stream stream;
    unsigned char output[16 * 1024];
    void *user;
    wm_gzip_bytes_callback outputCallback;
    int ended;
    int failed;
} WMGzipReader;

static inline wm_gzip_handle wm_gzip_create(void *user, wm_gzip_bytes_callback callback) {
    WMGzipReader *reader = (WMGzipReader *)calloc(1, sizeof(WMGzipReader));
    if (!reader) return NULL;
    reader->user = user; reader->outputCallback = callback;
    if (inflateInit2(&reader->stream, 16 + MAX_WBITS) != Z_OK) { free(reader); return NULL; }
    return reader;
}
static inline int wm_gzip_feed(wm_gzip_handle handle, const unsigned char *bytes, int size) {
    WMGzipReader *reader = (WMGzipReader *)handle;
    if (!reader || reader->failed || size < 0) return 0;
    if (size == 0) return 1;
    if (reader->ended) {
        if (inflateReset(&reader->stream) != Z_OK) return 0;
        reader->ended = 0;
    }
    reader->stream.next_in = (Bytef *)bytes;
    reader->stream.avail_in = (uInt)size;
    do {
        reader->stream.next_out = reader->output;
        reader->stream.avail_out = sizeof(reader->output);
        uInt before = reader->stream.avail_in;
        int result = inflate(&reader->stream, Z_NO_FLUSH);
        int produced = (int)(sizeof(reader->output) - reader->stream.avail_out);
        if (produced && !reader->outputCallback(reader->user, reader->output, produced)) {
            reader->failed = 1; return 0;
        }
        if (result == Z_STREAM_END) {
            reader->ended = 1;
            if (reader->stream.avail_in) {
                /* Concatenated gzip members are common in provider exports. */
                Bytef *remaining = reader->stream.next_in;
                uInt remainingSize = reader->stream.avail_in;
                if (inflateReset(&reader->stream) != Z_OK) { reader->failed = 1; return 0; }
                reader->stream.next_in = remaining; reader->stream.avail_in = remainingSize;
                reader->ended = 0;
                continue;
            }
            return 1;
        }
        if (result != Z_OK && result != Z_BUF_ERROR) { reader->failed = 1; return 0; }
        if (result == Z_BUF_ERROR || (before == reader->stream.avail_in && !produced)) break;
    } while (reader->stream.avail_in || reader->stream.avail_out == 0);
    /* Input remains only on an invalid/stalled stream, never silently drop it. */
    if (reader->stream.avail_in) { reader->failed = 1; return 0; }
    return 1;
}
static inline int wm_gzip_finish(wm_gzip_handle handle) {
    WMGzipReader *reader = (WMGzipReader *)handle;
    return reader && !reader->failed && reader->ended;
}
static inline void wm_gzip_destroy(wm_gzip_handle handle) {
    WMGzipReader *reader = (WMGzipReader *)handle;
    if (reader) { inflateEnd(&reader->stream); free(reader); }
}
